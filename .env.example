# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#
# OpenRouter API key — used by generate_mascot.py to call the image model.
# Get one at: https://openrouter.ai/keys   (format: sk-or-v1-...)
OPENROUTER_API_KEY=

# Optional: image model to route to on OpenRouter (defaults to a Gemini image model).
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# Optional: HTTP(S) proxy, only if the image model is region-locked for you.
# IMAGE_PROXY=http://127.0.0.1:7897
